<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tree_mapping</name>
  <version>0.1.0</version>
  <description>
    ROS 2 port of the DREAMS-lab tree_mapping package. Currently provides
    ``offboard_control`` (port of probe_docking.py): a PX4 OFFBOARD hover
    controller that talks to MAVROS for SITL or hardware-in-the-loop.
  </description>
  <maintainer email="deepgis@example.com">DeepGIS Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
